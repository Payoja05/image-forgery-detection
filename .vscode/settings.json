{
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/data/raw/**": true,
    "**/data/synthetic/**": true,
    "**/__pycache__/**": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/data/raw": true,
    "**/data/synthetic": true
  },
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "data/raw": true
  },
  "python.defaultInterpreterPath": "${workspaceFolder}\.venv\Scripts\python.exe",
  "python.analysis.exclude": ["**/.venv", "**/data"]
}
